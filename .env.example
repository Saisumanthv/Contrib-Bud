# Which open-weight model backend to use: "gemma" (default, via Gemini API) or "ollama" (local)
BUDDY_PROVIDER=gemma

# Required for BUDDY_PROVIDER=gemma — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model. Defaults: gemma-4-26b-a4b-it (gemma) / gemma4 (ollama)
# BUDDY_MODEL=gemma-4-31b-it

# Optional: Ollama server URL (default http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Optional but recommended: raises GitHub API limit from 60 to 5000 requests/hour.
# A fine-grained token with NO permissions (public repo read only) is enough.
GITHUB_TOKEN=
